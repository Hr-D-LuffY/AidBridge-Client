BACKEND_API_URL=http://localhost:5000/api/v1

NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-click demo login (server-only, never sent to the browser). Leave a pair blank to disable that
# role's button. These accounts must already exist on the backend: victim by signing up, volunteer
# by an approved volunteer request, ngo and admin created by an admin.
DEMO_VICTIM_EMAIL=
DEMO_VICTIM_PASSWORD=

DEMO_VOLUNTEER_EMAIL=
DEMO_VOLUNTEER_PASSWORD=

DEMO_NGO_EMAIL=
DEMO_NGO_PASSWORD=

DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Where the contact form sends its message (it opens the visitor's own email app or webmail, so nothing is
# sent by this site). Leave blank and the form is disabled with a notice.
NEXT_PUBLIC_CONTACT_EMAIL=
